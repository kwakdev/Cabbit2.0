# Copy to .env and replace every CHANGE_ME value before deployment.
APP_VERSION=0.1.0
API_IMAGE=ghcr.io/CHANGE_ME/cabbit-field-service-api
APP_HOSTNAME=fieldservice.localhost
# public starts Caddy on ports 80/443. Leave blank for Tailscale Serve mode.
COMPOSE_PROFILES=public
APP_CORS_ORIGINS=http://localhost:8081,http://localhost:19006
SQLSERVER_DATABASE=fieldservice
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=CHANGE_ME_Use_at_least_20_chars!
JWT_SECRET=CHANGE_ME_Base64_or_random_string_at_least_32_chars
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_Use_at_least_14_chars!
MINIO_ROOT_USER=fieldservice
MINIO_ROOT_PASSWORD=CHANGE_ME_Use_at_least_20_chars!
MINIO_BUCKET=field-service-photos
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_Use_at_least_20_chars!
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_Use_a_unique_long_passphrase
